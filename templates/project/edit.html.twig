{% extends 'base.html.twig' %}

{% block body %}
<div class="container">
<form method="POST">
<input type="hidden" name="_token" value="{{ csrf_token('project_form') }}">
<div class="mb-5">
    <label class="form-label" for="title">{{ 'project.name'|trans }}</label>
    <input type="text" value="{{project.name??''}}" name="name" id="name" class="form-control form-control-lg" required autofocus />
    {% include 'components/autosave_conflict.html.twig' %}
</div>

<div class="mb-3" style="max-width: 300px">
    <label class="form-label fw-bold">{{'project.period.header'|trans}}</label>
    <div class="input-group mb-3">
        <span class="input-group-text">{{'project.period.from'|trans}}</span>
        <input type="date" value="{{project.startDate|date('Y-m-d')}}"
        class="form-control" name="startDate" id="startDate" aria-label="Start date"
        >
        {% include 'components/autosave_conflict.html.twig' %}
    </div>
    <div class="input-group">
        <span class="input-group-text">{{'project.period.to'|trans}}</span>
        <input type="date" value="{{project.endDate|date('Y-m-d')}}" class="form-control" name="endDate" id="endDate" aria-label="End date"
        >
        {% include 'components/autosave_conflict.html.twig' %}
    </div>
</div>

<div class="mb-5">
    <label for="markdown-editor" class="form-label fw-bold d-flex justify-content-between align-items-center">
        <span>{{ 'project.description'|trans }}</span>
        <small class="text-body-secondary fw-normal">Markdown</small>
    </label>
    
    <div class="markdown-editor-wrapper">
        <textarea id="markdown-editor" name="description"
        class="form-control">{{project.description??''}}</textarea>
        {% include 'components/autosave_conflict.html.twig' %}
    </div>
</div>

<div class="mb-5">
{{component('TagPicker', {entityClass: 'App\\Entity\\Project', entityId: project.id})}}
</div>

<div class="d-flex justify-content-end w-100">
    <button class="btn btn-lg btn-primary mb-3" type="submit">
        {{ project==null?'project.create'|trans:'project.edit'|trans }}
    </button>
</div>

</form>
</div>
{% endblock %}