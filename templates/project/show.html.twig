{% extends 'base.html.twig' %}

{% block body %}
<div class="container">

<a href="{{ path('app_candidate_projects') }}" style="top:70px"
   class="mb-3 sticky-top btn btn-lg bg-body btn-outline-secondary text-body rounded-pill">
    <i class="bi bi-arrow-left fs-5 leading-none"></i>
    <span>{{'actions.back'|trans}}</span>
</a>
{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% set alert_type = label == 'error' ? 'danger' : label %}
        <div class="alert alert-{{ alert_type }} alert-dismissible fade show" role="alert">
            {{ message|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="d-flex width-100 justify-content-between">
    <h2>{{project.name}}</h2>
    <a class="btn btn-lg btn-outline-secondary" href="{{path('app_project_edit', {id: project.id})}}">{{'actions.edit'|trans}}</a>
</div>
{{"project.period.header"|trans}}:<h3>{{project.startDate|date('Y.m.d')}} - {{project.endDate|date('Y.m.d')}}</h3>
<div style="max-height:600px; overflow-x:auto" class="card p-4 m-2">
{{project.description|markdown_to_html}}
</div>
<div class="mb-5">
<h5>{{"project.tags"|trans}}:</h5>
{% for tag in project.tags %}
<span style="color: var(--bs-body) !important; background-color: var(--bs-info-bg-subtle)"
class="fs-6 badge rounded-pill border">{{tag}}</span>
{% endfor %}
</div>
</div>
{% endblock %}