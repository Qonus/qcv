{% extends 'base.html.twig' %}

{% block body %}
<div class="container">
    <div class="w-100 d-flex justify-content-between">
    <a class="link h2" href="{{path('app_position_show', {id: cv.position.id})}}">{{cv.position.name}}</a>
    {% if is_granted('edit', cv) %}
    <div class="d-flex gap-2">
        <a class="btn btn-lg btn-outline-secondary" href="{{path('app_cv_edit', {id: cv.id})}}">{{'actions.edit'|trans}}</a>
        <a class="btn btn-lg btn-outline-danger" href="{{path('app_cv_delete', {id: cv.id})}}">{{'actions.delete'|trans}}</a>
    </div>
    {% endif %}
    </div>
    <h2>{{'candidate.me'|trans}}</h2>
    <div class="card mb-3 p-2">
        {% for field in [
            {name:'candidate.email'|trans, value: candidate.email},
            {name:'candidate.name'|trans, value: firstName ~ ' ' ~ lastName},
            {name:'candidate.location'|trans, value: location},
            ] %}
        <div class="d-flex gap-3 align-items-center">
            <strong>{{field.name}}</strong>
            <span class="fs-5">{{field.value}}</span>
        </div>
    {% endfor %}
    </div>

    <h2>{{'candidate.info'|trans}}</h2>
    {% for attributeValue in attributeValues %}
    {% if attributeValue.value != null and (attributeValue.attribute.dataType.value != 'period' or (attributeValue.value.start != null and attributeValue.value.end != null)) %}
    {% set dataType = attributeValue.attribute.dataType.value %}

    {% if dataType == 'text' %}
    <div class="card mb-3">
        <div class="card-header">
            <strong class="fs-6">{{attributeValue.attribute.name}}</strong>
        </div>
        <div class="card-body align-items-center gap-4">
            {{attributeValue.value|markdown_to_html}}
        </div>
    </div>
    {% else %}
    <div class="card mb-3">
    <div class="card-body d-flex align-items-center gap-4">
        <strong class="fs-6">{{attributeValue.attribute.name}}</strong>
        {% if dataType == 'boolean' %}
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" {{ attributeValue.valueBoolean ? 'checked' : '' }} disabled>
        </div>
        {% elseif dataType == 'numeric' %}
            <span>{{attributeValue.value}}</span>
        {% elseif dataType == 'date' %}
            <span>{{attributeValue.value|date('Y.m.d')}}</span>
        {% elseif dataType == 'period' %}
            <span>{{attributeValue.value.start|date('Y.m.d')}} - {{attributeValue.value.end|date('Y.m.d')}}</span>
        {% elseif dataType == 'select' %}
            <span>{{attributeValue.valueOption.value}}</span>
        {% elseif dataType == 'image' %}
            <span>{{attributeValue.value}}</span>
        {% else %}
            <span>{{attributeValue.value}}</span>
        {% endif %}
    </div>
    </div>
    {% endif %}
    {% endif %}
    {% endfor %}
    <h2>{{'candidate.projects'|trans}}</h2>
{# <h2>{{'candidate.cvs'|trans}}</h2> #}
</div>
{% endblock %}