{% extends 'base.html.twig' %}

{% block body %}
<div class="container">
    {% include 'components/flashes.html.twig' %}
    {# <input type="hidden" name="_token" value="{{ csrf_token('cv_form') }}"> #}
    <form method="POST">
    <h2 class="mb-4">{{'cv.mandatory_fields'|trans}}:</h2>
    {% for a in requiredAttributes %}
    <div class="card mb-2 {{a.attributeValue == null ? 'border-danger bg-danger-subtle': ''}}">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <label class="form-label fw-semibold">{{ a.attribute.name }}</label>
            </div>
            {% if a.attributeValue != null %}
            {{component('AttributeValueEditor', {
                attributeValue: a.attributeValue,
                required: true,
                key: 'attribute-value-' ~ a.attributeValue.id})}}
            {% else %}
            <a class="btn btn-primary" href="{{path('app_attribute_value_create', {id: a.attribute.id})}}">{{'actions.create'|trans}}</a>
            {% endif %}
        </div>
    </div>
    {% endfor %}

    <button class="btn btn-primary" type="submit">{{'actions.submit'|trans}}</button>
    </form>
</div>
{% endblock %}