{% extends 'base.html.twig' %}

{% block title %}{{'errors.403.header'|trans}}{% endblock %}
{% block body %}
<div class="container-sm mt-5">
    <h1>{{'errors.403.header'|trans}}</h1>
    <p>{{'errors.403.description'|trans}}</p>
    <div class="w-100 d-flex justify-content-between">
