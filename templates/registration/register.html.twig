{% extends 'security/_auth_layout.html.twig' %}

{% block title %}{{ 'auth.register.page_title'|trans }}{% endblock %}
{% block card_title %}{{ 'auth.register.card_title'|trans }}{% endblock %}

{% block auth_content %}
{% for flash_error in app.flashes('verify_email_error') %}
    <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
{% endfor %}

{% if form_errors(registrationForm) %}
    <div class="alert alert-danger">
        {{ form_errors(registrationForm) }}
    </div>
{% endif %}

{{ form_start(registrationForm) }}
    {{ form_widget(registrationForm) }}

    <button type="submit" class="btn btn-lg btn-primary mb-3 w-100">
        {{ 'auth.register.submit'|trans }}
    </button>
    <div class="mb-4 text-center">
        <span class="text-muted small">{{ 'auth.register.already_have_account'|trans }}</span>
        <a href="{{ path('app_login') }}" class="small text-decoration-none fw-semibold">{{ 'auth.register.sign_in'|trans }}</a>
    </div>
{{ form_end(registrationForm) }}
{% endblock %}