{% extends 'base.html.twig' %}

{% block title %}My Profile{% endblock %}
{% set current_route = app.request.attributes.get('_route') %}
{% block body %}
<div class="container py-4">
    <div id="save-conflict-alert" class="alert alert-warning d-none" role="alert">
        Someone (or another tab) changed this value first. Refresh to see the latest.
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item">
        <a class="nav-link {{ current_route == 'app_profile' ? 'active' : '' }}" 
           href="{{ path('app_profile') }}">{{'profile.me'|trans}}</a></li>
    <li class="nav-item">
        <a class="nav-link {{ current_route == 'app_candidate_attributes' ? 'active' : '' }}" 
           href="{{ path('app_candidate_attributes') }}">{{'profile.info'|trans}}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link {{ current_route == 'app_candidate_projects' ? 'active' : '' }}" 
           href="{{ path('app_candidate_projects') }}">{{'profile.projects'|trans}}</a></li>
    <li class="nav-item">
        <a class="nav-link {{ current_route == 'app_candidate_cvs' ? 'active' : '' }}" 
           href="{{ path('app_candidate_cvs') }}">{{'profile.cvs'|trans}}</a></li>
    </ul>

    <div class="tab-content">
        {% block contents %}
        {{component("ProfilePage", {
            firstName: firstName,
            lastName: lastName,
            location: location,
            image: image
            })}}
        {% endblock %}
    </div>
</div>

{% endblock %}