{% extends 'profile/index.html.twig' %}
{% block title %}{{'project.plural'|trans}}{% endblock %}
{% block contents %}
<div class="tab-pane active">
    <div class="d-flex justify-content-end mb-3">
        <a href={{ path('app_project_create') }} class="btn btn-primary btn-sm">+ {{'actions.create'}}</a>
    </div>
    <table class="table table-hover align-middle">
        <thead><tr><th>{{'project.name'|trans}}</th><th>{{'project.period.label'|trans}}</th><th>{{'project.tags'|trans}}</th><th class="text-end"></th></tr></thead>
        <tbody>
        {% for project in projects %}
            <tr class="clickable-row" data-href="{{ path('app_project_show', {id: project.id}) }}">
                <td>{{ project.name }}</td>
                <td>{{ project.startDate|date('Y-m') }} - {{ project.endDate|date('Y-m')}}</td>
                <td><div class="table-list-container">
                    {% set tags = project.tags %}
                    {% set limit = 7 %}
                    {% for tag in tags|slice(0,limit) %}
                    <span style="color: var(--bs-body) !important; background-color: var(--bs-info-bg-subtle)"
                        class="badge rounded-pill border">{{tag}}</span>
                    {% endfor %}
                    {% if tags|length > limit %}
                    <span style="color: var(--bs-body) !important; background-color: var(--bs-info-bg-subtle)"
                        class="badge rounded-pill border">+{{ tags|length - limit }}</span>
                    {% endif %}
                </div></td>
                <td class="text-end">
                    <div class="dropdown">
                        <button class="btn btn-link" data-bs-toggle="dropdown">⋮</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_project_edit', {id: project.id}) }}">{{'actions.edit'|trans}}</a></li>
                            <li><button class="dropdown-item text-danger" data-project-delete="{{ project.id }}">{{'actions.delete'|trans}}</button></li>
                        </ul>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="text-muted text-center py-4">{{'no_results'|trans}}</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}