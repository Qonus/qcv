{% extends 'profile/index.html.twig' %}
{% block title %}CVs{% endblock %}
{% block contents %}
<div class="tab-pane fade" id="tab-cvs">
    <table class="table table-hover align-middle">
        <thead><tr><th>Position</th><th>Status</th><th>Likes</th><th class="text-end"></th></tr></thead>
        <tbody>
        {# {% for cv in cvs %}
            <tr>
                <td>{{ cv.position.title }}</td>
                <td><span class="badge {{ cv.status == 'published' ? 'text-bg-success' : 'text-bg-secondary' }}">{{ cv.status }}</span></td>
                <td>{{ cv.likes|length }}</td>
                <td class="text-end"><a href="{{ path('app_cv_show', {id: cv.id}) }}" class="btn btn-sm btn-outline-primary">Open</a></td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="text-muted text-center py-4">No CVs yet.</td></tr>
        {% endfor %} #}
        </tbody>
    </table>
</div>
{% endblock %}