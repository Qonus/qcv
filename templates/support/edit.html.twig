{% extends 'base.html.twig' %}
{% block body %}
<div class="container my-4" style="max-width: 640px">
    <h1 class="h3 mb-3">{{'support.ticket'|trans}}</h1>
    <p class="text-muted small">{{'support.page'|trans}}: {{ back }}</p>
    {{ form_start(form) }}
    {{ form_rest(form) }}
    <div class="d-flex justify-content-end gap-3">
        <a class="btn btn-outline-secondary" href="{{ back }}">{{'actions.cancel'|trans}}</a>
        <button class="btn btn-primary">{{'actions.send'|trans}}</button>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}