{% extends 'base.html.twig' %}
{% block body %}
<div class="container my-4" style="max-width: 720px">
  <h1 class="h3 mb-3">CRM {{'nav.profile.label'|trans}}</h1>
  {{ form_start(form) }}
    <div class="row">
      <div class="col-md-6">{{ form_row(form.firstName) }}</div>
      <div class="col-md-6">{{ form_row(form.lastName) }}</div>
      <div class="col-md-6">{{ form_row(form.email) }}</div>
      <div class="col-md-6">{{ form_row(form.role) }}</div>
    </div>
    <hr>
    {{ form_rest(form) }}
    <div class="d-flex justify-content-end gap-3">
        <a class="btn btn-outline-secondary" href="{{ path('app_profile', {id: user.id}) }}">{{'actions.cancel'|trans}}</a>
        <button class="btn btn-primary">{{'actions.save'|trans}}</button>
    </div>
  {{ form_end(form) }}
</div>
{% endblock %}