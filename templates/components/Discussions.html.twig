<div {{attributes}} class="mb-5" data-poll="delay(5000)|$render">
    {% if app.user %}
    <div class="d-flex justify-content-end mb-3 w-100">
        <button class="btn btn-primary" data-action="live#action"
            data-live-action-param="createPost">{{'discussion.create'|trans}}</button>
    </div>
    {% endif %}
    {% set postArray = (this.editingPostId == -1 ? [{author:app.user, id:-1, content: ""}]: [])|merge(this.posts) %}
    {% for post in postArray %}
    <div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between w-100 mb-3">
            {% set url = is_granted('ROLE_RECRUITER')? path('app_candidate_show', {email: post.author.email??''}): '' %}
            <a href="{{url}}" class="d-block text-decoration-none" role="button" aria-expanded="false">
                <img src="{{ post.author.image?:asset('images/avatar-placeholder.svg') }}" class="rounded-circle border" width="40" height="40" style="object-fit: cover;">
                {{ post.author.email??'' }}
            </a>
            {% if post.id != this.editingPostId and app.user and app.user.id == post.author.id %}
            <div class="dropdown">
                <button class="btn btn-sm btn-link" data-bs-toggle="dropdown">⋮</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><button class="dropdown-item" data-action="live#action"
                    data-live-action-param="editPost"
                    data-live-id-param="{{ post.id }}">{{'actions.edit'|trans}}</button></li>
                    <li><button class="dropdown-item text-danger" data-action="live#action"
                    data-live-action-param="deletePost"
                    data-live-id-param="{{ post.id }}">{{'actions.delete'|trans}}</button></li>
                </ul>
            </div>
            {% endif %}
        </div>
        
        {% if post.id != this.editingPostId %}
        <div>
            {{post.content|markdown_to_html}}
        </div>
        {% else %}
        <div id="post {{post.id}}" class="mb-3">
            <div class="markdown-editor-wrapper">
                <textarea
                data-controller="easy-mde"
                name="description"
                class="form-control"
                 data-model="debounce(300)|content">
                    {{post.content}}</textarea>
                {% include 'components/autosave_conflict.html.twig' %}
            </div>
        </div>
        <div class="d-flex justify-content-end gap-3">
            <button class="btn btn-outline-secondary" data-action="live#action"
            data-live-action-param="setEditingPost">{{'actions.cancel'|trans}}</button>
            <button class="btn btn-primary" data-action="live#action"
            data-live-action-param="savePost">{{'actions.save'|trans}}</button>
        </div>
        {% endif %}
    </div>
    </div>
    {% endfor %}
</div>