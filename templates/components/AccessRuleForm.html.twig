{# templates/components/AttributeRuleItem.html.twig #}
<div {{ attributes }} class="card border-0 shadow-sm mb-3 bg-light">
    <div class="card-body p-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            {# Match Type (AND / OR) #}
            {% if this.index != 0 %}
            <div style="min-width: 90px;">
                <select name="matchType[]" data-model="matchType" class="form-select form-select-sm fw-semibold bg-white" autocomplete="off">
                    <option value="and" selected>{{ 'filter.match_type.and'|trans }}</option>
                    <option value="or">{{ 'filter.match_type.or'|trans }}</option>
                </select>
            </div>
            {% endif %}

            {# Attribute Selector #}
            <div class="flex-grow-1" style="min-width: 180px;">
                <select data-controller="tom-select" style="max-width: 300px"
                        name="attributeId[]"
                        id="attribute-{{ this.key|default('0') }}" 
                        class="form-select form-select-sm bg-white" 
                        autocomplete="off">
                    <option value="">-- {{ 'filter.select_attribute'|trans }} --</option>
                    {% for attr in this.getAttributes %}
                        <option value="{{ attr.id }}">
                            {{ attr.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            {# Attribute Dimension #}
            {% set dataType = this.attribute ? this.attribute.dataType.value : '' %}
            <div style="min-width: 140px;">
                <select name="attributeDimension[]" data-model="attributeDimension" class="form-select form-select-sm bg-white" autocomplete="off">
                    {% if dataType != 'period' %}
                        <option value="value" selected>{{ 'filter.target_property.value'|trans }}</option>
                        {% if dataType in ['string', 'text'] %}
                            <option value="length">{{ 'filter.target_property.length'|trans }}</option>
                        {% endif %}
                    {% else %}
                        <option value="duration">{{ 'filter.target_property.duration'|trans }}</option>
                        <option value="start_date">{{ 'filter.target_property.start_date'|trans }}</option>
                        <option value="end_date">{{ 'filter.target_property.end_date'|trans }}</option>
                    {% endif %}
                </select>
            </div>

            {# Operation #}
            <div style="min-width: 140px;">
                <select name="operation[]" data-model="operation" class="form-select form-select-sm bg-white" autocomplete="off">
                    <option value="equals" selected>{{ 'filter.operation.equals'|trans }}</option>
                    <option value="not_equals">{{ 'filter.operation.not_equals'|trans }}</option>
                    {% if dataType in ['numeric', 'date'] or this.attributeDimension in ['length', 'duration', 'start_date', 'end_date'] %}
                        <option value="greater_than">{{ 'filter.operation.greater_than'|trans }}</option>
                        <option value="less_than">{{ 'filter.operation.less_than'|trans }}</option>
                    {% endif %}
                </select>
            </div>

            {# Filter Value Input #}
            <div class="flex-grow-1" style="min-width: 160px;">
                {% if dataType in ['numeric'] or this.attributeDimension in ['length'] %}
                    <input data-model="filterValue" class="form-control form-control-sm bg-white" type="number" placeholder="Enter value..." autocomplete="off">
                {% elseif this.attributeDimension in ['duration'] %}
                    <div class="input-group input-group-sm">
                        <input data-model="filterValue" class="form-control bg-white" type="number" placeholder="Days..." autocomplete="off">
                        <span class="input-group-text bg-white text-muted">days</span>
                    </div>
                {% elseif dataType in ['date'] or this.attributeDimension in ['start_date', 'end_date'] %}
                    <input data-model="filterValue" class="form-control form-control-sm bg-white" type="date" autocomplete="off">
                {% else %}
                    <input data-model="filterValue" class="form-control form-control-sm bg-white" type="text" placeholder="Enter value..." autocomplete="off">
                {% endif %}
            </div>

            {# Delete Action #}
            <div>
                <button type="button" 
                        class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center" 
                        style="width: 32px; height: 32px;"
                        data-action="live#emitUp"
                        data-live-name-param="removeRule"
                        data-live-index-param="{{ this.index }}"
                        title="Delete Rule">
                    X
                </button>
            </div>
        </div>
    </div>
</div>