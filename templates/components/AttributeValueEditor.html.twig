<div {{ attributes }}>
    <div class="mb-3">
    {% set valueExist = this.attributeValue.valueExists  %}
    {% set dataType = this.attributeValue.attribute.dataType.value %}
    {% if dataType == 'boolean' %}
        <div class="form-check form-switch" {{this.required?'required':''}}>
            <input class="form-check-input" type="checkbox" role="switch" data-model="debounce(300)|value">
        </div>
    {% elseif dataType == 'text' %}
        <textarea data-controller="easy-mde" class="form-control {{this.required?'required':''}}
        {{ valueExist ? '' : 'is-invalid' }}"
            data-model="debounce(300)|value" rows="3"></textarea>
    {% elseif dataType == 'numeric' %}
        <input type="number" step="any" data-model="debounce(300)|value" {{this.required?'required':''}}
            class="form-control {{ valueExist ? '' : 'is-invalid' }}">
    {% elseif dataType == 'date' %}
        <input type="date" data-model="debounce(300)|value" {{this.required?'required':''}}
                class="form-control {{ valueExist ? '' : 'is-invalid' }}">
    {% elseif dataType == 'period' %}
        <input type="date" data-model="periodValue.start" {{this.required?'required':''}}
            class="form-control mb-3 {{ valueExist ? '' : 'is-invalid' }}">
        <input type="date" data-model="periodValue.end" {{this.required?'required':''}}
            class="form-control {{ valueExist ? '' : 'is-invalid' }}">
    {% elseif dataType == 'select' %}
        <select class="form-control {{ valueExist ? '' : 'is-invalid' }}" {{this.required?'required':''}}
        data-model="debounce(300)|value">
            <option value="">---</option>
            {% for option in this.attributeValue.attribute.options %}
            <option value="{{option.id}}">{{option.value}}</option>
            {% endfor %}
        </select>
    {% elseif dataType == 'image' %}
        <input type="text" data-model="debounce(300)|value" {{this.required?'required':''}}
            class="form-control {{ this.attributeValue.valueString is null ? 'is-invalid' : '' }}">
    {% else %}
        <input type="text" data-model="debounce(300)|value" {{this.required?'required':''}}
            class="form-control {{ this.attributeValue.valueString is null ? 'is-invalid' : '' }}">
    {% endif %}
    </div>
    <div class="d-flex justify-content-between">
        {% if this.isSaved and this.isValidValue %}
        <span class="text-success">
            ✓ {{'actions.saved'|trans}}
        </span>
        {% else %}
        <span class="text-danger">
            x {{'actions.unsaved'|trans}}
        </span>
        {% endif %}
        <button class="btn btn-primary" type="button" data-action="live#action"
        {{this.isValidValue?'':'disabled'}}
        data-live-action-param="save">{{'actions.save'|trans}}</button>
    </div>
</div>