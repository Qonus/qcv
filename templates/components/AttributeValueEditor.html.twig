<div {{ attributes }}>
    <div class="mb-3">
    {% if this.attributeValue.attribute.dataType.value == 'boolean' %}
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" data-model="debounce(300)|value">
        </div>
    {% elseif this.attributeValue.attribute.dataType.value == 'text' %}
        <textarea data-controller="easy-mde" class="form-control {{this.attributeValue.value is null ? 'is-invalid' : ''}}"
            data-model="debounce(300)|value" rows="3"></textarea>
    {% elseif this.attributeValue.attribute.dataType.value == 'numeric' %}
        <input type="number" step="any" data-model="debounce(300)|value"
            class="form-control {{this.attributeValue.value is null ? 'is-invalid' : ''}}">
    {% elseif this.attributeValue.attribute.dataType.value == 'date' %}
        <input type="date" data-model="debounce(300)|value"
                class="form-control {{this.attributeValue.value is null ? 'is-invalid' : ''}}">
    {% elseif this.attributeValue.attribute.dataType.value == 'period' %}
        <input type="date" data-model="debounce(300)|periodValue.start"
            class="form-control mb-3 {{this.attributeValue.valueDate is null ? 'is-invalid' : ''}}">
        <input type="date" data-model="debounce(300)|periodValue.end"
            class="form-control {{this.attributeValue.valueDateEnd is null ? 'is-invalid' : ''}}">
    {% elseif this.attributeValue.attribute.dataType.value == 'select' %}
        <select class="form-control {{this.attributeValue.value is null ? 'is-invalid' : ''}}" data-model="debounce(300)|value">
            <option value="">---</option>
            {% for option in this.attributeValue.attribute.options %}
            <option value="{{option.id}}">{{option.value}}</option>
            {% endfor %}
        </select>
    {% elseif this.attributeValue.attribute.dataType.value == 'image' %}
        <input type="text" data-model="debounce(300)|value"
            class="form-control {{ this.attributeValue.valueString is null ? 'is-invalid' : '' }}">
    {% else %}
        <input type="text" data-model="debounce(300)|value"
            class="form-control {{ this.attributeValue.valueString is null ? 'is-invalid' : '' }}">
    {% endif %}
    </div>
    <div class="d-flex justify-content-end">
        <button class="btn btn-primary" data-action="live#action"
        data-live-action-param="save">{{'actions.save'|trans}}</button>
    </div>
</div>