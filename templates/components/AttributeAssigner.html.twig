<div {{attributes}}>
<select data-controller="position-attributes" multiple
        name="attributes[]"
        class="form-select form-select-lg" 
        autocomplete="off">
    <option value="">{{ 'access_rule.select_attribute'|trans }}</option>
    {% for attr in this.attributes %}
        <option value="{{ attr.id }}" {{ attr.id in this.selectedAttributeIds ? 'selected' : '' }}>
            {{ attr.name }}
        </option>
    {% endfor %}
</select>
</div>