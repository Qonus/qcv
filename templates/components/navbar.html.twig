
{# {% set route = app.request.attributes.get('_route') %}
{% set params = app.request.attributes.get('_route_params') %} #}
<nav class="navbar navbar-expand-md sticky-top bg-body" style="min-height: 70px;z-index:1000">
  <div class="container-fluid bg-body">
    <a class="navbar-brand" href="/">Quick CV</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse justify-content-between" id="navbarContent">
        <ul class="navbar-nav mb-lg-0 align-items-center">
            <li class="nav-item">
            <a class="nav-link" aria-current="page" href="{{path("app_positions")}}">{{"nav.positions"|trans}}</a>
            </li>
            {% if is_granted('ROLE_RECRUITER') %}
            <li class="nav-item">
            <a class="nav-link" aria-current="page"
            href="{{path("app_admin")}}">{{"nav.admin"|trans}}</a> </li>
            {% endif %}
        </ul>
        <form class="d-flex" role="search">
            <input name="q" class="form-control me-2" value="{{ app.request.query.get('q') }}"
            type="search" placeholder="{{'nav.search'|trans}}" aria-label="Search"/>
            <input name="tag" value="{{ app.request.query.get('tag') }}"
            type="hidden" aria-label="Tag"/>
            <button class="btn btn-outline-success" type="submit">{{'nav.search'|trans}}</button>
        </form>
        
        {% if app.user %}
        <ul class="navbar-nav">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false">
                    <img src="{{ app.user.image ?: asset('images/avatar-placeholder.svg') }}" class="rounded-circle border" width="40" height="40" style="object-fit: cover;">
                    {{ app.user.email }}
                </a>
                <ul style="z-index:99999000" class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                <li><a class="dropdown-item" href={{ path('app_profile') }}>{{ 'nav.profile.label'|trans }}</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">{{'nav.appearance'|trans}}</h6></li>
                <li><a class="dropdown-item {% if theme == 'dark' %}active{% endif %}"
                    href={{ path('app_switch_theme', {theme: 'dark'}) }}>{{ 'nav.dark'|trans }}</a></li>
                <li><a class="dropdown-item {% if theme == 'light' %}active{% endif %}"
                    href={{ path('app_switch_theme', {theme: 'light'}) }}>{{ 'nav.light'|trans }}</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">{{ 'nav.language'|trans }}</h6></li>
                <li><a class="dropdown-item {% if locale == 'en' %}active{% endif %}"
                    href={{ path('app_switch_locale', {locale: 'en'}) }}>English</a></li>
                <li><a class="dropdown-item {% if locale == 'ru' %}active{% endif %}"
                    href={{ path('app_switch_locale', {locale: 'ru'}) }}>Русский</a></li>
                <li><hr class="dropdown-divider"></li>
                <li class="">
                    <form action={{path('app_logout')}} method="POST" class="d-flex m-0">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="dropdown-item" title="Logout" data-bs-toggle="tooltip">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="">{{ 'nav.logout'|trans }}</span>
                        </button>
                    </form>
                </li>
            </ul>
            </li>
            
        </ul>
        {% else %}
        <a class="btn btn-outline-primary" href={{ path('app_login') }}>
            {{"nav.login"|trans}}
        </a>
        {% endif %}
    </div>
  </div>
</nav>