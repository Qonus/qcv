<div class="d-none autosave-conflict alert alert-warning py-2 px-3 mt-1 mb-2 justify-content-between align-items-center gap-2">
    <span>{{'conflict.message'|trans|raw}}</span>
    <span class="d-flex gap-2 flex-shrink-0">
        <button type="button" class="btn btn-sm btn-outline-danger" data-resolve="mine">{{'conflict.mine'|trans}}</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-resolve="theirs">{{'conflict.theirs'|trans}}</button>
    </span>
</div>