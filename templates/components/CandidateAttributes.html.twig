<div {{ attributes }}>
<div class="tab-pane">
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAttributeModal">
            + Add Attribute
        </button>
    </div>

    <div class="row g-3" id="info-attribute-list">
        {% for attributeValue in this.attributeValues %}
            <div class="col-md-6" data-info-row={{attributeValue.id }}>
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <label class="form-label fw-semibold">{{ attributeValue.attribute.name }}</label>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-link text-muted" data-bs-toggle="dropdown">⋮</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><button class="dropdown-item text-danger remove-attribute-btn"
                                        data-attribute-id="{{ attributeValue.id }}">Remove</button></li>
                                </ul>
                            </div>
                        </div>

                        {% if attributeValue.attribute.dataType.value == 'boolean' %}
                            <div class="form-check form-switch">
                                <input class="form-check-input autosave-field" type="checkbox" role="switch"
                                        data-attribute-id="{{ attributeValue.id }}"
                                        data-version="{{ attributeValue.version }}"
                                        {{ attributeValue.valueBoolean ? 'checked' : '' }}>
                            </div>
                        {% elseif attributeValue.attribute.dataType.value == 'text' %}
                            <textarea class="form-control autosave-field {{ attributeValue.valueText is null ? 'is-invalid' : '' }}"
                                        data-attribute-id="{{ attributeValue.id }}"
                                        data-version="{{ attributeValue.version }}" rows="3">{{ attributeValue.valueText }}</textarea>
                        {% elseif attributeValue.attribute.dataType.value == 'numeric' %}
                            <input type="number" step="any"
                                    class="form-control autosave-field {{ attributeValue.valueNumeric is null ? 'is-invalid' : '' }}"
                                    data-attribute-id="{{ attributeValue.id }}" data-version="{{ attributeValue.version }}"
                                    value="{{ attributeValue.valueNumeric }}">
                        {% elseif attributeValue.attribute.dataType.value == 'date' %}
                            <input type="date"
                                    class="form-control autosave-field {{ attributeValue.valueNumeric is null ? 'is-invalid' : '' }}"
                                    data-attribute-id="{{ attributeValue.id }}" data-version="{{ attributeValue.version }}"
                                    value="{{ attributeValue.valueNumeric }}">
                        {% else %}
                            <input type="text" class="form-control autosave-field {{ attributeValue.valueString is null ? 'is-invalid' : '' }}"
                                    data-attribute-id="{{ attributeValue.id }}" data-version="{{ attributeValue.version }}"
                                    value="{{ attributeValue.valueString }}">
                        {% endif %}
                        <small class="text-muted">Empty values show highlighted — recruiters see them in red.</small>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<div class="modal fade" id="addAttributeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Attribute</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            
            {# HIDDEN SEARCH ATTRIBUTE MODAL BODY #}
            <div class="modal-body">
                <input 
                    type="text" 
                    class="form-control mb-3" 
                    placeholder="Search attributes..." 
                    data-model="debounce(200)|query"
                    autocomplete="off"
                >
                <div class="list-group">
                {% for item in this.results %}
                    <button
                        type="button"
                        class="list-group-item list-group-item-action"
                        data-action="live#action"
                        data-live-action-param="selectOption"
                        data-live-id-param={{item.id}}>
                        {{item.name}} <span class="badge text-bg-light border">{{item.category}}</span>
                    </button>
                {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
</div>