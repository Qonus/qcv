<div {{ attributes }}>
<div class="tab-pane">
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addAttributeModal">
            {{'actions.create'|trans}}
        </button>
    </div>

    <div class="row g-3" id="info-attribute-list">
        {% for attributeValue in this.attributeValues %}
            <div class="">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <label class="form-label fw-semibold">{{ attributeValue.attribute.name }}</label>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-link text-muted" data-bs-toggle="dropdown">⋮</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><button class="dropdown-item text-danger"
                                        data-action="live#action"
                                        data-live-action-param="deleteAttributeValue"
                                        data-live-id-param="{{ attributeValue.id }}">{{'actions.delete'|trans}}</button></li>
                                </ul>
                            </div>
                        </div>
                        {{component('AttributeValueEditor', {
                            attributeValue: attributeValue,
                            key: 'attribute-value-' ~ attributeValue.id})}}
                    </div>
                </div>
            </div>
        {% else %}
        <div class="card">
            <div class="card-body">
                {{'profile.no_attributes'|trans}}
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<div class="modal fade" id="addAttributeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Attribute</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            
            {# HIDDEN SEARCH ATTRIBUTE MODAL BODY #}
            <div class="modal-body">
                <select data-controller="candidate-attributes"
                        data-candidate-attributes-url-value="{{path('app_attribute_search', {forUser: true})}}"
                        name="attribute"
                        onchange="this.closest('.modal').querySelector('[data-bs-dismiss=\'modal\']').click();"
                        id="attribute-{{ this.key|default('0') }}" 
                        class="form-select"
                        autocomplete="off">
                    <option value="">-- {{ 'filter.select_attribute'|trans }} --</option>
                    {# {% for attr in this.attributes %}
                        <option value="{{ attr.id }}" {{attr.id == this.attributeId ? 'selected' : ''}}>
                            {{ attr.name }}
                        </option>
                    {% endfor %} #}
                </select>
                {# <input 
                    type="text" 
                    class="form-control mb-3" 
                    placeholder="Search attributes..." 
                    data-model="debounce(200)|query"
                    autocomplete="off"
                >
                <div class="list-group">
                {% for item in this.results %}
                    <button
                        type="button"
                        class="list-group-item list-group-item-action"
                        data-action="live#action"
                        data-live-action-param="addAttribute"
                        data-live-id-param={{item.id}}>
                        {{item.name}} <span class="badge text-bg-light border">{{item.category}}</span>
                    </button>
                {% endfor %} #}
                </div>
            </div>
        </div>
    </div>
</div>
</div>