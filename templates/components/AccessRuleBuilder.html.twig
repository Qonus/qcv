{# templates/components/AttributeRuleBuilder.html.twig #}
<div {{ attributes }}>
    <div class="card border shadow-sm">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="card-title mb-0 fw-bold text-secondary">
                <i class="bi bi-filter me-1"></i> Access Rules & Filters
            </h6>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                {{ this.rules|length }} {{ this.rules|length == 1 ? 'Rule' : 'Rules' }}
            </span>
        </div>

        <div class="card-body p-3">
            {% if this.rules is empty %}
                <div class="text-center py-4 text-muted border border-dashed rounded">
                    <p class="mb-2">No access rules added yet.</p>
                    <button type="button" class="btn btn-sm btn-primary" data-action="live#action" data-live-action-param="addRule">
                        + Add First Rule
                    </button>
                </div>
            {% else %}
                <div class="rules-container">
                    {% for index, rule in this.rules %}
                        {{ component('AccessRuleForm', {
                            key: 'rule-' ~ (rule.id|default(index)),
                            index: index,
                            matchType: rule.matchType,
                            attributeId: rule.attributeId,
                            attributeDimension: rule.attributeDimension,
                            operation: rule.operation,
                            filterValue: rule.filterValue,
                            position: this.position,
                        }) }}
                    {% endfor %}
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                    <button type="button" 
                            class="btn btn-sm btn-outline-primary fw-semibold" 
                            data-action="live#action" 
                            data-live-action-param="addRule">
                        + Add Another Rule
                    </button>

                    {# <button type="button" 
                            class="btn btn-sm btn-success px-4" 
                            data-action="live#action" 
                            data-live-action-param="saveRules">
                        Save Rules
                    </button> #}
                </div>
            {% endif %}
        </div>
    </div>
</div>