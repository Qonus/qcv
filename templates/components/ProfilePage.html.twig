<div {{attributes}} class="tab-pane show active">
    <div class="row g-4">
        <div class="col-md-3 text-center">
            {# {% set photoAttr = builtinAttributes|filter(a => a.name == 'Personal Photo')|first %} #}
            {# {% set photoValue = photoAttr ? valuesByAttributeId[photoAttr.id] ?? null : null %} #}
            <img src={{asset('images/avatar-placeholder.svg')}}
                class="rounded-circle mb-2 border" width="140" height="140" style="object-fit: cover;" id="profile-photo-preview">

            <br>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    id="change-photo-btn">
                    {# data-attribute-id="{{ photoAttr.id }}" #}
                    {# data-version="{{ photoValue ? photoValue.version : '' }}"> #}
                Change Photo
            </button>
        </div>
        <div class="col-md-9">
            <div class="form-floating mb-3">
                <input type="text" class="form-control {{ this.firstName == '' ? 'is-invalid' : '' }}"
                    id="firstName"
                    data-model="debounce(200)|firstName"
                    value={{this.firstName}}>
                <label for="firstName">{{ "profile.firstName"|trans }}</label>
            </div>
            <div class="form-floating mb-3">
                <input type="text" class="form-control {{ this.lastName == '' ? 'is-invalid' : '' }}"
                    id="lastName"
                    data-model="debounce(200)|lastName"
                    value={{this.lastName}}>
                <label for="lastName">{{ "profile.lastName"|trans }}</label>
            </div>
            <div class="form-floating mb-3">
                <input type="text" class="form-control {{ this.location == '' ? 'is-invalid' : '' }}"
                    id="location"
                    data-model="debounce(200)|location"
                    value={{this.location}}>
                <label for="location">{{ "profile.location"|trans }}</label>
            </div>
            {# {% for fieldName in ['First Name', 'Last Name', 'Location'] %}
                {% set attr = builtinAttributes|filter(a => a.name == fieldName)|first %}
                {% set val = attr ? valuesByAttributeId[attr.id] ?? null : null %}
                <div class="form-floating mb-3">
                    <input type="text" class="form-control autosave-field {{ val is null ? 'is-invalid' : '' }}"
                        id="attr-{{ attr.id }}"
                        data-attribute-id="{{ attr.id }}"
                        data-version="{{ val ? val.version : '' }}"
                        value="{{ val ? val.valueString : '' }}">
                    <label for="attr-{{ attr.id }}">{{ fieldName }}</label>
                </div>
            {% endfor %} #}
        </div>
    </div>
</div>