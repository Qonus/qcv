<div {{attributes}} class="tab-pane show active" data-poll="delay(5000)|save">
    <div class="row g-4">
        <div class="col-md-3 text-center">
            <img src="{{ this.image ?: asset('images/avatar-placeholder.svg')}}"
                class="rounded-circle mb-2 border" width="140" height="140" style="object-fit: cover;" id="profile-photo-preview">
            <br>

            <div class="col">
                <input type="file" name="image" id="image-input" accept="image/*" style="display: none;"
                data-action="change->live#action"
                data-live-action-param="files(image)|uploadImage"
                >
                <p data-loading="action(uploadImage)|delay|show" class="text-primary fw-bold">
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    {{'actions.loading'|trans}}...
                </p>
                <button type="button" class="btn btn-primary" onclick="document.getElementById('image-input').click();"
                >
                    {{'actions.change'|trans}}
                </button>
            </div>
            {# <div data-loading="show" class="spinner-border spinner-border-sm text-primary mt-2" role="status">
                <span class="visually-hidden">Uploading to Cloudinary...</span>
            </div> #}
        </div>
        <div class="col-md-9">
            {% set t = "attribute.builtin" %}
            <div class="form-floating mb-3">
                <input type="text" class="form-control {{ this.firstName == '' ? 'is-invalid' : '' }}"
                    id="firstName"
                    data-model="debounce(200)|firstName"
                    value={{this.firstName}}>
                <label for="firstName">{{ (t~".firstName")|trans }}</label>
            </div>
            <div class="form-floating mb-3">
                <input type="text" class="form-control {{ this.lastName == '' ? 'is-invalid' : '' }}"
                    id="lastName"
                    data-model="debounce(200)|lastName"
                    value={{this.lastName}}>
                <label for="lastName">{{ (t~".lastName")|trans }}</label>
            </div>
            <div class="form-floating mb-3">
                <input type="text" class="form-control {{ this.location == '' ? 'is-invalid' : '' }}"
                    id="location"
                    data-model="debounce(200)|location"
                    value={{this.location}}>
                <label for="location">{{ (t~".location")|trans }}</label>
            </div>
            <div class="d-flex justify-content-between mt-4">
                <div class="save-status fs-7 text-muted">
                    <span data-loading="action(save)|delay|show" class="text-primary fw-bold">
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        {{'actions.saving'|trans}}...
                    </span>
                    <span data-loading="action(save)|delay|hide">
                        {% if this.isUnsaved %}
                        <span class="text-primary">
                            {# x Unsaved #}
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            {{'actions.saving'|trans}}...
                        </sapn>
                        {% else %}
                        <span class="text-success">
                            ✓ {{'actions.saved'|trans}}
                        </sapn>
                        {% endif %}
                    </span>
                </div>
                <button type="submit" 
                        class="btn btn-primary px-4" 
                        data-action="live#action" 
                        data-live-action-param="save">
                    {{ 'actions.save'|trans }}
                </button>
            </div>
        </div>
    </div>
</div>