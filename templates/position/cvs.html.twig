{% extends 'base.html.twig' %}
{% block title %}CVs{% endblock %}
{% block body %}
<div class="container">
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead><tr><th>{{'position.singular'|trans}}</th><th>{{'user.email.label'|trans}}</th><th class="text-end">{{'like.plural'|trans}}</th><th class="text-end"></th></tr></thead>
        <tbody>
        {% for cv in cvs %}
            {% set liked = cv in liked_cvs %}
            <tr class="clickable-row" data-href="{{ path('app_cv_show', {id: cv.id}) }}">
                <td>{{ cv.position.name }}</td>
                <td>{{ cv.candidate.email }}</td>
                <td class="text-end"><a class="btn btn-outline-secondary p-1 border" href="{{path('app_cv_like', {id: cv.id})}}">
                    {{ cv.likes|length }}
                    <i class="bi {{ liked ? 'bi-heart-fill':'bi-heart'}} ms-2 text-danger">
                </button></td>
                <td class="text-end"><div class="dropdown">
                    <button class="btn btn-link" data-bs-toggle="dropdown">⋮</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('app_cv_show', {id: cv.id}) }}">{{'actions.open'|trans}}</a></li>
                        {% if is_granted("edit", cv) %}
                        <li><a class="dropdown-item" href="{{ path('app_cv_edit', {id: cv.id}) }}">{{'actions.edit'|trans}}</a></li>
                        <li><a class="dropdown-item text-danger" href="{{ path('app_cv_delete', {id: cv.id}) }}">{{'actions.delete'|trans}}</a></li>
                        {% endif %}
                    </ul>
                </div></td>
            </tr>
        {% else %}
            <tr><td colspan="4" class="text-muted text-center py-4">{{'no_results'|trans}}</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
</div>
{% endblock %}