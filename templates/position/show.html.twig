{% extends 'base.html.twig' %}
{% block body %}
<div class="container">

{% include 'components/flashes.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{{ui.back()}}
<div class="mb-5">
    {% if is_granted('ROLE_RECRUITER') %}
    <div class="d-flex float-end flex-wrap gap-2 mb-3">
        <a class="btn btn-lg btn-outline-secondary" href="{{path('app_position_edit', {id: position.id})}}">{{'actions.edit'|trans}}</a>
        <a class="btn btn-lg btn-outline-primary" href="{{path('app_position_duplicate', {id: position.id})}}">{{'actions.duplicate'|trans}}</a>
        <a class="btn btn-lg btn-outline-danger" href="{{path('app_position_delete', {id: position.id})}}">{{'actions.delete'|trans}}</a>
    </div>
    {% endif %}
    <h1>{{position.name}}</h1>
</div>
{{"position.company"|trans}}:<h3>{{position.company}}</h3>
<div style="max-height:600px; overflow-x:auto" class="card p-4 m-2">
{{position.description|markdown_to_html}}
</div>
<div class="mb-3">
<h5>{{"position.attributes"|trans}}:</h5>
{% for attribute in position.attributes %}
<span style="color: var(--bs-body) !important; background-color: var(--bs-info-bg-subtle)"
class="fs-6 badge border">{{attribute}}</span>
{% endfor %}
</div>
<div class="mb-5">
<h5>{{"position.tags"|trans}}:</h5>
{% for tag in position.tags %}
<span style="color: var(--bs-body) !important; background-color: var(--bs-info-bg-subtle)"
class="fs-6 badge rounded-pill border">{{tag}}</span>
{% endfor %}
</div>

<div class="d-flex gap-2 mb-5">
    {% if is_granted("ROLE_RECRUITER") %}
    <a class="btn btn-lg btn-outline-secondary" href="{{path('app_position_cvs', {id: position.id})}}">{{'position.cvs'|trans}}</a>
    {% endif %}
    {% if cv != null %}
    <a class="btn btn-lg btn-outline-secondary" href="{{path('app_cv_show', {id: cv.id})}}">{{'position.my_cv'|trans}}</a>
    {% elseif is_granted("ROLE_CANDIDATE") %}
    <a class="btn btn-lg btn-outline-primary" href="{{path('app_position_apply', {id: position.id})}}">{{'actions.apply'|trans}}</a>
    {% endif %}
</div>

<h3>{{"position.discussions"|trans}}:</h3>
{{ component('Discussions', {position: position})}}

</div>
{% endblock %}