{% extends 'base.html.twig' %}

{% block body %}
<div class="container">
{# 
Scrapped Back link
<a href="{{ path('app_positions') }}" style="top:70px"
   class="mb-3 sticky-top btn btn-lg bg-body btn-outline-secondary text-body rounded-pill">
    <i class="bi bi-arrow-left fs-5 leading-none"></i>
    <span>Positions</span>
</a> #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% set alert_type = label == 'error' ? 'danger' : label %}
        <div class="alert alert-{{ alert_type }} alert-dismissible fade show" role="alert">
            {{ message|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="d-flex width-100 justify-content-between">
    <h1>{{position.name}}</h1>
    <a class="btn btn-lg btn-outline-secondary" href="{{path('app_position_edit', {id: position.id})}}">{{'position.edit'|trans}}</a>
</div>
{{"position.company"|trans}}:<h3>{{position.company}}</h3>
<div style="max-height:600px; overflow-x:auto" class="card p-4 m-2">
{{position.description|markdown_to_html}}
</div>
<div class="mb-3">
<h5>{{"position.attributes"|trans}}:</h5>
{% for attribute in position.attributes %}
<span style="color: var(--bs-body) !important; background-color: var(--bs-info-bg-subtle)"
class="fs-6 badge border">{{attribute}}</span>
{% endfor %}
</div>
<div class="mb-5">
<h5>{{"position.tags"|trans}}:</h5>
{% for tag in position.tags %}
<span style="color: var(--bs-body) !important; background-color: var(--bs-info-bg-subtle)"
class="fs-6 badge rounded-pill border">{{tag}}</span>
{% endfor %}
</div>

<h3>{{"position.discussions"|trans}}:</h3>
</div>
{% endblock %}