<odoo>
  <record id="view_qcv_import_wizard" model="ir.ui.view">
    <field name="name">qcv.import.wizard.form</field><field name="model">qcv.import.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group><field name="base_url"/><field name="api_token" password="True"/></group>
        <footer>
          <button name="action_import" type="object" string="Import" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_qcv_import" model="ir.actions.act_window">
    <field name="name">Import from QCV app</field><field name="res_model">qcv.import.wizard</field>
    <field name="view_mode">form</field><field name="target">new</field>
  </record>
</odoo>